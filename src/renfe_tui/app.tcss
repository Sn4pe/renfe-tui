Screen {
    background: $background;
    padding: 1 2;
}

#hero {
    height: auto;
    margin-bottom: 1;
}

#wordmark, #tagline {
    width: 1fr;
    text-align: center;
}

#tagline {
    margin: 1 0;
}

Home Center {
    height: auto;
}

#form {
    width: 100%;
    max-width: 82;
    height: auto;
}

.row {
    height: 1;
    margin-bottom: 1;
}

.field {
    width: 9;
    height: 1;
    color: $text-muted;
}

Input {
    height: 1;
    border: none;
    padding: 0 1;
    background: $surface;
}

Input:focus {
    border: none;
    background: $primary 18%;
}

Input.station {
    width: 56;
}

Input.short {
    width: 16;
    margin-right: 1;
}

.time-label {
    width: auto;
    height: 1;
    color: $text-muted;
    margin-right: 1;
}

Select {
    width: 19;
    margin-right: 1;
}

Select > SelectCurrent {
    background: $surface;
}

Select:focus > SelectCurrent {
    background: $primary 18%;
}

#day-label, .hint {
    width: 1fr;
    height: 1;
    padding-left: 1;
}

#suggestions {
    width: 56;
    height: auto;
    max-height: 7;
    border: none;
    background: $surface;
    margin: -1 0 0 9;
    padding: 0;
    overlay: screen;
    constrain: none inside;
}

Button {
    height: 1;
    min-width: 0;
    width: auto;
    border: none;
    padding: 0 2;
    margin-right: 1;
    background: $surface;
    color: $foreground;
    text-style: none;
    content-align: center middle;
}

Button:hover, Button:focus {
    background: $panel;
    text-style: bold;
}

Button.primary {
    background: $primary;
    color: $background;
    text-style: bold;
}

Button.primary:hover, Button.primary:focus {
    background: $secondary;
}

Button.choice.selected {
    background: $primary;
    color: $background;
}

Button.quiet {
    background: transparent;
    color: $primary;
}

Button.quiet:hover, Button.quiet:focus {
    background: $surface;
}

#swap {
    padding: 0 1;
    margin-left: 1;
}

#message {
    height: auto;
    margin-left: 9;
}

#more {
    width: auto;
    height: 1;
    margin-top: 1;
}

#route {
    height: auto;
    margin-bottom: 1;
}

#status {
    height: auto;
    margin-bottom: 1;
}

DataTable {
    height: 1fr;
    background: $background;
}

DataTable > .datatable--header {
    background: $background;
    color: $text-muted;
    text-style: none;
}

DataTable > .datatable--cursor {
    background: $primary;
    color: $background;
}

#detail {
    height: auto;
    margin-top: 1;
}

#fares {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

#detail-actions {
    width: 32;
    height: auto;
}

#detail-actions Button {
    width: 100%;
    margin-bottom: 1;
}

#delay {
    height: 3;
    content-align: left middle;
}

#where {
    height: auto;
    margin-bottom: 1;
}

AskTrain, PayWith {
    align: center middle;
    background: $background 70%;
}

.dialog {
    width: 56;
    height: auto;
    padding: 1 2;
    background: $surface;
}

.dialog Input {
    width: 100%;
    margin: 1 0;
}

.title {
    text-style: bold;
    margin-bottom: 1;
}

.buttons {
    height: 1;
    margin-top: 1;
}

.page {
    max-width: 84;
    padding: 0 2;
}

.page-title {
    margin-bottom: 1;
}

.section {
    height: auto;
    margin-bottom: 1;
}

.credits-train {
    margin-bottom: 1;
}

.credit {
    height: auto;
    margin-bottom: 1;
}

.credit-text {
    width: 1fr;
    height: auto;
}

.credit Button {
    margin-top: 1;
}

.unofficial {
    margin-top: 1;
}

.cal-hint {
    width: 28;
    height: auto;
    margin-top: 1;
}

DatePicker {
    align: center middle;
    background: $background 70%;
}

DatePicker .dialog {
    width: 34;
}

* {
    scrollbar-corner-color: $panel;
    scrollbar-background: $panel;
    scrollbar-background-hover: $panel;
    scrollbar-background-active: $panel;
    scrollbar-color: $primary;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
}

#schedule, #segments {
    height: auto;
    margin-bottom: 1;
}

#train-filter {
    width: 48;
    margin-bottom: 1;
}

#progress {
    height: auto;
    margin: 1 0;
}

#methods {
    height: auto;
    max-height: 10;
    margin: 1 0;
}

Follow Static, Checkout Static {
    max-width: 84;
}
